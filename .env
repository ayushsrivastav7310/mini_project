# Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Flask App Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-key-in-production-medical-waste-2026

# Database
# Default: SQLite file in instance/medical_waste.db
DATABASE_URL=sqlite:///medical_waste.db

# Storage & Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=16

# AI Engine Settings
AI_CONFIDENCE_THRESHOLD=0.75
AI_MODEL_PATH=models/mobilenetv2_medical_waste.h5
USE_DEMO_HEURISTIC_IF_TF_MISSING=True

# Hospital Metadata (Used for Reports and Headings)
HOSPITAL_NAME=Apollo-Lifeline Multispecialty Hospital
HOSPITAL_CODE=ALMH-BMW-REG-4821
HOSPITAL_ADDRESS=Health City, Sector 14, New Delhi - 110001
HOSPITAL_POLLUTION_CONTROL_BOARD_ID=PCB/BMW/2026/0942
